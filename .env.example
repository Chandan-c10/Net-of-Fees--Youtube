# Copy to .env and fill in. Never commit .env.
# Every credential lives in an environment variable, never in the
# database and never in the repo -- architecture doc, section 28.

# ---- pipeline ----
PROFILE=trading
VOICE=chandan_en

# silent = draft, no model needed, cannot be published
# cloned = your cloned voice (primary)
# kokoro = generic fallback
VOICE_ENGINE=silent

# template = deterministic, offline, no key
# gemini   = free tier, needs GEMINI_API_KEY
# ollama   = local, needs `ollama serve`
SCRIPT_ENGINE=template

# ---- optional: script generation ----
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1

# ---- optional: publishing ----
# Add each episode to a playlist named after its series. Needs a wider
# OAuth scope than uploading does, which is visible on the consent
# screen and in the API audit -- so set this BEFORE authorising, or
# re-run tools/youtube_auth.py after changing it.
# YOUTUBE_PLAYLISTS=1
# YOUTUBE_TOKEN_FILE=secrets/youtube_token.json

# Several channels from one install. A profile publishes to the channel
# named after it, so these are only needed to override a location.
# Authorise another channel with:
#   python tools/youtube_auth.py --channel trading
# which writes secrets/youtube_token_trading.json and is picked up
# automatically.
# YOUTUBE_TOKEN_FILE_TRADING=

# Instagram Reels. Needs a Business or Creator account linked to a
# Facebook Page, a Meta app with instagram_content_publish, and a
# long-lived token. README, 'Instagram setup'.
# IG_USER_ID=
# IG_ACCESS_TOKEN=
# Per-channel accounts. Suffix with the channel name, uppercased. These
# win over the unsuffixed pair above, which stays the fallback.
# IG_USER_ID_TRADING=
# IG_ACCESS_TOKEN_TRADING=
# IG_API_VERSION=v21.0
# Set only if you host the file yourself; otherwise it uploads from disk.
# IG_VIDEO_URL=

# ---- disk retention ----
# 0 keeps everything, which is the default. Working files are scene
# WAVs, clips and frames -- all reproducible by re-running a stage.
# RETAIN_WORKING_DAYS=1
# A video is only ever removed once the episode is published or
# archived. An unpublished one is the only copy of work you have not
# judged yet, so this setting cannot delete it.
# RETAIN_VIDEO_DAYS=7

# ---- archive storage (optional, S3-compatible) ----
# A cloud render's artifact is deleted after 7 days; this keeps a copy
# that is not. Cloudflare R2 has free egress, which for video is the
# difference between a free tier and a surprise.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Only if the bucket is served on a domain of your own.
# R2_PUBLIC_BASE_URL=
# R2 gives 10 GB free and bills $0.015/GB/month past it without asking.
# Uploads stop at this cap instead of starting to charge. 0 disables the
# check, which also stops it listing the bucket.
# R2_STORAGE_CAP_GB=9.5
# Delete archived episodes older than this. The cap stops the bucket
# growing; this stops it filling. A week covers the seven days a cloud
# render's artifact lasts, by which point the episode is published or
# abandoned. 0 keeps everything.
# R2_RETAIN_DAYS=7

# ---- voice reference ----
# Where your recordings live, if not on this machine. Downloaded at
# render time and deleted afterwards, so a cloud runner keeps no copy.
# This is a CREDENTIAL: a link to your voice reference is a link to your
# voice. Keep it out of commits and prefer a restricted link.
# A Drive "anyone with the link" URL works; a folder link does not.
# VOICE_REFERENCE_URL=
# VOICE_REFERENCE_URL_CHANDAN_EN=
# Better: put the recordings in the private archive bucket and name the
# object instead. No public link exists, so none can leak.
# VOICE_REFERENCE_KEY=voices/chandan_en.zip
# VOICE_REFERENCE_KEY_CHANDAN_EN=
# Set to keep a downloaded reference between runs (local machines only).
# KEEP_VOICE_REFERENCE=

# ---- scheduling and batching ----
# Publishing times, "HH:MM,HH:MM". The number of slots is also the
# number of episodes a day the queue releases.
# PUBLISH_SLOTS=08:30,19:30
# CHANNEL_TZ=Asia/Kolkata
# How many episodes `run.py batch` drafts in one go.
# BATCH_SIZE=10
# Refuse to queue further ahead than this.
# MAX_QUEUE_DAYS=14

# ---- optional: control panel ----
# Only needed with --host beyond 127.0.0.1. `--token` with no value
# generates one per run; set this to keep the same link across restarts.
# DASHBOARD_TOKEN=

# ---- optional: alerts ----
# Mailed when a stage fails, and when a scheduled draft reaches Gate 1.
# Unset, the pipeline simply does not mail; it never fails because of it.
# Verify with:  python run.py notify-test
# ALERT_EMAIL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Only for an unencrypted relay on localhost:
# SMTP_STARTTLS=1
# SMTP_USER=
# For Gmail this must be an app password, not the account password:
# https://myaccount.google.com/apppasswords
# SMTP_APP_PASSWORD=

# ---- overrides, usually unnecessary ----
# FFMPEG_BIN=
# FFPROBE_BIN=
# TORCH_DEVICE=cpu
# THUMBNAIL_FONT=

# ---- scene pictures ----
# Each scene's image_prompt is written with the script; these decide who
# draws it. Tried in order, so a generator being down falls through to
# stock rather than to a title card.
#
#   pollinations  free hosted Flux, no key, pictures made for the line
#   openverse     Creative Commons stock, filtered to commercial reuse
#   local         a diffusion server you run, needs IMAGE_LOCAL_URL
#
# A Creative Commons picture is credited automatically in the
# description; that is a licence term, not a courtesy.
# Generation only by default. Adding openverse makes stock the
# fallback, which is right for factual subjects and wrong for stories:
# a keyword search matched a Hubble photograph to a village market.
# IMAGE_PROVIDERS=pollinations
#
# Set to 0 when you are placing pictures in sources/ by hand.
# IMAGE_FETCH=1
#
# Appended to every prompt so one episode looks like one hand.
# IMAGE_STYLE=cinematic still, natural light, muted colour, no text
#
# A local AUTOMATIC1111-compatible server. Nothing leaves the network.
# IMAGE_LOCAL_URL=http://127.0.0.1:7860
# IMAGE_LOCAL_STEPS=28

# ---- reusing pictures ----
# A picture drawn once is kept in state/images and used again when a
# later scene asks for something close enough. A story returns to the
# same subject; four slightly different men on four slightly different
# doorsteps is worse than one man seen four ways.
#
# The cap on how many NEW pictures one episode draws. 0 is no cap. Set
# it to 6 and a fourteen-scene episode draws six and reuses them for
# the rest -- much faster on a free generator, and usually better to
# watch than fourteen near-identical frames.
# IMAGE_MAX_NEW=0
#
# IMAGE_REUSE=1
# IMAGE_REUSE_THRESHOLD=0.45
#
# Seconds between requests. The free generator refuses bursts.
# IMAGE_PACE_SEC=8
